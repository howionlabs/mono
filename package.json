{
    "name": "@howionlabs/mono",
    "version": "0.1.0",
    "private": true,
    "description": "Howion's custom (and quite opinionated) monorepo to manage all of its repositories.",
    "keywords": ["howion", "monorepo", "monorepository"],
    "homepage": "https://www.howion.com/",
    "license": "MIT",
    "author": {
        "name": "howion",
        "email": "me@howion.com",
        "url": "https://www.howion.com"
    },
    "main": "./.mono/mono.ts",
    "bin": "./.mono/cli.ts",
    "scripts": {
        "mono": "bun run ./.mono/cli.ts",
        "format": "bunx --bun @biomejs/biome format --write",
        "lint": "bunx --bun @biomejs/biome lint --write"
    },
    "dependencies": {
        "@biomejs/biome": "2.5.7",
        "@types/bun": "^1.3.14",
        "@types/node": "26.1.2",
        "cac": "7.0.0",
        "dotenv": "^17.4.2",
        "simple-git": "^3.36.0",
        "typescript": "^7.0.2",
        "markdownlint": "^0.41.1"
    },
    "engines": {
        "bun": ">=1.3.14"
    },
    "workspaces": [
        "apps/*",
        "modules/*"
    ]
}
