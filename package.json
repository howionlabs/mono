{
    "name": "@howionlabs/mono",
    "version": "0.1.0",
    "description": "Howion's custom (and quite opinionated) monorepo to manage all of its repositories.",
    "private": true,
    "devDependencies": {
        "@biomejs/biome": "2.5.6",
        "@types/bun": "1.3.14",
        "@types/node": "26.1.2",
        "cac": "7.0.0",
        "dotenv": "^17.4.2"
    },
    "peerDependencies": {
        "typescript": "^5.9.3"
    },
    "scripts": {
        "remold": "bun run ./bin/index.ts remold",
        "mono:format": "biome format --write .",
        "mono:lint": "biome lint ."
    },
    "workspaces": [
        "apps/*",
        "modules/*"
    ]
}
