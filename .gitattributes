# normalize cross-os eol to lf for text-based files
* text=auto eol=lf
# windows batch/install files should use crlf
*.bat text eol=crlf
*.cmd text eol=crlf
# make sure svg files are treated as text files
*.svg text eol=lf
# fonts
*.ttf filter=lfs diff=lfs -text
*.eot filter=lfs diff=lfs -text
*.otf filter=lfs diff=lfs -text
*.woff filter=lfs diff=lfs -text
*.woff2 filter=lfs diff=lfs -text
